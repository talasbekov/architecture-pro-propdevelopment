<mxfile host="app.diagrams.net" modified="2026-07-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="context-smart-home" name="C4 — Контекст">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 System Context — управление умным домом" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="owner" value="&lt;b&gt;Собственник / жилец&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Управляет доступом и открывает устройства через мобильное приложение" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="staff" value="&lt;b&gt;Сотрудник УК&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Администрирует разрешения в пределах своей управляющей компании и домов" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="prop" value="&lt;b&gt;PropDevelopment&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;Текущее мобильное приложение и сервисы ЖКУ: проверяют личность, полномочия и согласие, передают команды умному дому" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=14;" vertex="1" parent="1"><mxGeometry x="490" y="290" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="partner" value="&lt;b&gt;Платформа умного дома партнёра&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;Принимает авторизованные команды, управляет устройствами и возвращает события и статусы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="330" height="210" as="geometry"/></mxCell>
        <mxCell id="intercom" value="&lt;b&gt;Интеллектуальный домофон&lt;/b&gt;&lt;br&gt;[External Device]&lt;br&gt;Звонок, открытие; опциональное распознавание лица по согласию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1010" y="630" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="barrier" value="&lt;b&gt;Интеллектуальный шлагбаум&lt;/b&gt;&lt;br&gt;[External Device]&lt;br&gt;Открытие и распознавание разрешённых номеров автомобилей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1010" y="800" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="e1" value="Использует мобильное приложение; команды открытия; управляет согласиями и доступом&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="owner" target="prop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Решения о доступе в своей зоне ответственности&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="staff" target="prop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Авторизованные команды и решения о доступе&lt;br&gt;[HTTPS REST, OAuth 2.0, mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="prop" target="partner"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e4" value="События устройств, результат команды, статус&lt;br&gt;[HTTPS callback / async events]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.65;entryX=1;entryY=0.65;" edge="1" parent="1" source="partner" target="prop"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="18" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e5" value="Команды и политики доступа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="partner" target="intercom"><mxGeometry relative="1" as="geometry"><mxPoint x="-55" y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e6" value="Команды и разрешённые номера" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.8;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="partner" target="barrier"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="-55" as="offset"/><Array as="points"><mxPoint x="1370" y="540"/><mxPoint x="1370" y="785"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="События и статусы домофона" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;exitX=0.65;exitY=0;entryX=0.65;entryY=1;" edge="1" parent="1" source="intercom" target="partner"><mxGeometry relative="1" as="geometry"><mxPoint x="55" y="8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e8" value="События и статусы шлагбаума" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;exitX=0.9;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="barrier" target="partner"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="55" as="offset"/><Array as="points"><mxPoint x="1410" y="785"/><mxPoint x="1410" y="540"/></Array></mxGeometry></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Легенда C4&lt;/b&gt;&lt;br&gt;[Person] — пользователь системы&lt;br&gt;[Software System] — система PropDevelopment&lt;br&gt;[External Software System] — внешняя программная система&lt;br&gt;[External Device] — внешнее физическое устройство&lt;br&gt;Сплошная стрелка — синхронный запрос/команда; пунктир — событие/обратный вызов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="650" width="470" height="210" as="geometry"/></mxCell>
