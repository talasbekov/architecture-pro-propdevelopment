        <mxCell id="e18" value="Команда открытия / разрешённые номера" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="partner" target="barrier"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="Событие / статус устройства" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="barrier" target="partner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="Callback / события и статусы [signed HTTPS или async events; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;" edge="1" parent="1" source="partner" target="integration"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="Аудит команды, решения и результата [async events; request ID]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;" edge="1" parent="1" source="integration" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Легенда C4&lt;/b&gt;: Person — пользователь; Container — приложение/сервис; Database — хранилище; External System — внешняя система. Синие блоки с толстой рамкой и пометкой НОВЫЙ — предлагаемые компоненты. Сплошная стрелка — синхронный вызов/команда, пунктир — событие/статус." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="1270" width="1350" height="80" as="geometry"/></mxCell>
