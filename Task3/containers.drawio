  <diagram id="containers-smart-home" name="C4 — Контейнеры">
    <mxGraphModel dx="2100" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 Container — развитие группы сервисов ЖКУ: умный дом" style="text;html=1;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="jkuBoundary" value="PropDevelopment — Группа сервисов ЖКУ (доверенная зона)" style="swimlane;html=1;whiteSpace=wrap;startSize=36;fillColor=#EAF3FB;strokeColor=#1168BD;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="1420" height="1160" as="geometry"/></mxCell>
        <mxCell id="partnerBoundary" value="Партнёр — внешняя trust boundary" style="swimlane;html=1;whiteSpace=wrap;startSize=36;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1770" y="80" width="390" height="1160" as="geometry"/></mxCell>
        <mxCell id="owner" value="&lt;b&gt;Собственник / жилец&lt;/b&gt;&lt;br&gt;[Person]" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="30" y="210" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="mobile" value="&lt;b&gt;Витрина сервисов для собственников&lt;/b&gt;&lt;br&gt;[Container: Mobile app iOS/Android]&lt;br&gt;Текущее мобильное приложение для собственников" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="45" y="90" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="tenant" value="&lt;b&gt;tenant-core-app&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Текущее приложение услуг собственникам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="45" y="350" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="tenantdb" value="&lt;b&gt;tenant-core-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;База данных услуг ЖКХ по собственникам" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="45" y="530" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="crm" value="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Система управления данными собственников" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="45" y="750" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="crmdb" value="&lt;b&gt;crm-tenant-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;База данных CRM по собственникам" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="45" y="930" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="auth" value="&lt;b&gt;auth-service-1&lt;/b&gt;&lt;br&gt;[Container: Keycloak]&lt;br&gt;Текущий сервис аутентификации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="350" y="750" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="authdb" value="&lt;b&gt;auth-db-1&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;База данных сервиса аутентификации" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="jkuBoundary"><mxGeometry x="350" y="930" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway — НОВЫЙ&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;OIDC/OAuth 2.0, WAF, rate limit, маршрутизация, request ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;strokeWidth=3;" vertex="1" parent="jkuBoundary"><mxGeometry x="380" y="90" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="integration" value="&lt;b&gt;Smart Home Integration Service — НОВЫЙ&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;Проверяет полномочия/согласие, адаптирует API и оркестрирует команды и события" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;strokeWidth=3;" vertex="1" parent="jkuBoundary"><mxGeometry x="730" y="90" width="315" height="150" as="geometry"/></mxCell>
        <mxCell id="consent" value="&lt;b&gt;Consent &amp;amp; Access Registry Service — НОВЫЙ&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;Решения о согласиях и доступе с tenant scope и сроком действия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;strokeWidth=3;" vertex="1" parent="jkuBoundary"><mxGeometry x="730" y="350" width="315" height="135" as="geometry"/></mxCell>
        <mxCell id="consentdb" value="&lt;b&gt;Consent &amp;amp; Access Registry DB — НОВАЯ&lt;/b&gt;&lt;br&gt;[Container: Database]&lt;br&gt;Согласия и разрешения; без сырых биометрических шаблонов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;strokeWidth=3;" vertex="1" parent="jkuBoundary"><mxGeometry x="770" y="550" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit / Event Stream — НОВЫЙ&lt;/b&gt;&lt;br&gt;[Container: Event Broker / Audit]&lt;br&gt;Метаданные аудита и асинхронные события без чувствительной нагрузки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;strokeWidth=3;" vertex="1" parent="jkuBoundary"><mxGeometry x="730" y="780" width="315" height="135" as="geometry"/></mxCell>
        <mxCell id="supplier" value="&lt;b&gt;Поставщик ресурсов ЖКХ&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;Текущая интеграция начислений/услуг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="partner" value="&lt;b&gt;API платформы умного дома&lt;/b&gt;&lt;br&gt;[External Container]&lt;br&gt;Исполняет команды и принимает события устройств" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="partnerBoundary"><mxGeometry x="55" y="120" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="intercom" value="&lt;b&gt;Интеллектуальный домофон&lt;/b&gt;&lt;br&gt;[External System / Device]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="partnerBoundary"><mxGeometry x="55" y="450" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="barrier" value="&lt;b&gt;Интеллектуальный шлагбаум&lt;/b&gt;&lt;br&gt;[External System / Device]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="partnerBoundary"><mxGeometry x="55" y="720" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="e1" value="Использует приложение [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="owner" target="mobile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Текущие услуги ЖКУ [REST]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mobile" target="tenant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Аутентификация [OIDC]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mobile" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Данные собственника [REST]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mobile" target="crm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Услуги собственника [JDBC]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="tenant" target="tenantdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Данные собственника [JDBC]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="crm" target="crmdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Учётные записи [JDBC]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="authdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Текущая интеграция [REST]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="tenant" target="supplier"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Умный дом [HTTPS REST; OIDC token]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="mobile" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Валидация токена [OIDC/OAuth 2.0]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="gateway" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Команда + tenant context [HTTPS REST; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="gateway" target="integration"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="Проверка объекта/собственника [HTTPS REST; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="integration" target="tenant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="Проверить согласие и доступ [HTTPS REST; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="integration" target="consent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="Read/write [TLS; least privilege]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="consent" target="consentdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="Разрешённая команда [HTTPS REST; OAuth 2.0 Client Credentials; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="integration" target="partner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="Команда открытия / политика доступа" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="partner" target="intercom"><mxGeometry relative="1" as="geometry"/></mxCell>
