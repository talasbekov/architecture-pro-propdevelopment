<mxfile host="app.diagrams.net" modified="2026-07-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="containers-smart-home" name="C4 — Контейнеры">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C4 Container — сервисы ЖКУ и интеграция с умным домом" style="text;html=1;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="pdBoundary" value="PropDevelopment — доверенная зона" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#EAF3FB;strokeColor=#1168BD;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1120" height="930" as="geometry"/></mxCell>
        <mxCell id="partnerBoundary" value="Партнёр — внешняя trust boundary" style="swimlane;html=1;whiteSpace=wrap;startSize=34;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1510" y="90" width="410" height="930" as="geometry"/></mxCell>
        <mxCell id="owner" value="&lt;b&gt;Собственник / жилец&lt;/b&gt;&lt;br&gt;[Person]" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="staff" value="&lt;b&gt;Сотрудник УК&lt;/b&gt;&lt;br&gt;[Person]" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="mobile" value="&lt;b&gt;Мобильное приложение собственника&lt;/b&gt;&lt;br&gt;[Container: Mobile frontend]&lt;br&gt;Текущий интерфейс услуг ЖКУ и умного дома" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="pdBoundary"><mxGeometry x="45" y="80" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="showcase" value="&lt;b&gt;Витрина собственников&lt;/b&gt;&lt;br&gt;[Container: Web frontend]&lt;br&gt;Текущий веб-интерфейс ЖКУ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="pdBoundary"><mxGeometry x="45" y="700" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;OIDC/OAuth 2.0, WAF, rate limit, маршрутизация, request ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="pdBoundary"><mxGeometry x="365" y="80" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="tenant" value="&lt;b&gt;tenant-core-app&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;Текущая бизнес-логика ЖКУ, привязка собственника, УК, дома и помещения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="pdBoundary"><mxGeometry x="365" y="300" width="260" height="135" as="geometry"/></mxCell>
        <mxCell id="crm" value="&lt;b&gt;CRM собственников / Auth&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;Профиль, роли и аутентификационный контекст" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="pdBoundary"><mxGeometry x="365" y="700" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="integration" value="&lt;b&gt;Smart Home Integration Service&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;Проверяет полномочия и согласие, адаптирует API партнёра, оркестрирует команды и события" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="pdBoundary"><mxGeometry x="700" y="80" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="consent" value="&lt;b&gt;Consent &amp;amp; Access Registry Service&lt;/b&gt;&lt;br&gt;[Container: Service]&lt;br&gt;Решения о согласиях и доступе с tenant scope и сроком действия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="pdBoundary"><mxGeometry x="700" y="330" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="consentdb" value="&lt;b&gt;Consent &amp;amp; Access Registry DB&lt;/b&gt;&lt;br&gt;[Container: Database]&lt;br&gt;Согласия, разрешения, идентификаторы устройств; без сырых биометрических шаблонов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="pdBoundary"><mxGeometry x="735" y="520" width="240" height="135" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit / Event Stream&lt;/b&gt;&lt;br&gt;[Container: Event Broker / Audit]&lt;br&gt;Неизменяемые метаданные аудита и асинхронные события без чувствительной нагрузки" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amazon_mq;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#1168BD;" vertex="1" parent="pdBoundary"><mxGeometry x="700" y="710" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="partner" value="&lt;b&gt;API платформы умного дома&lt;/b&gt;&lt;br&gt;[External Container]&lt;br&gt;Исполняет команды и управляет устройствами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="partnerBoundary"><mxGeometry x="65" y="110" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="devices" value="&lt;b&gt;Домофон и шлагбаум&lt;/b&gt;&lt;br&gt;[External Systems / Devices]&lt;br&gt;Распознавание и физическое управление доступом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="partnerBoundary"><mxGeometry x="65" y="430" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="partnerEvents" value="&lt;b&gt;События партнёра&lt;/b&gt;&lt;br&gt;[External Event Endpoint]&lt;br&gt;Статусы команд и события устройств" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#666666;" vertex="1" parent="partnerBoundary"><mxGeometry x="65" y="700" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="Функции умного дома [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="owner" target="mobile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Администрирование [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="staff" target="showcase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="API [HTTPS REST; OIDC access token]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="mobile" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="API [HTTPS REST; OIDC]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="showcase" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Команда + tenant context [HTTPS REST; mTLS; OAuth 2.0]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="gateway" target="integration"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Проверка принадлежности объекта [HTTPS REST; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="gateway" target="tenant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Профиль и роли [HTTPS REST; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="tenant" target="crm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Проверить согласие и доступ [HTTPS REST; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="integration" target="consent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Read/write [TLS; least privilege]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="consent" target="consentdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Разрешённая команда [HTTPS REST; OAuth 2.0 client credentials; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="integration" target="partner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Команды / статусы" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="partner" target="devices"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="События [signed HTTPS callback или async events; mTLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="partnerEvents" target="integration"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="Аудит решения и результата [async events; request ID]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="integration" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Легенда C4&lt;/b&gt;: Person — пользователь; Container — исполняемое приложение/сервис; Database — хранилище; Event Broker — поток событий; External Container/System — компонент вне trust boundary. Сплошная стрелка — синхронный вызов, пунктир — асинхронное событие." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="1040" width="1050" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
